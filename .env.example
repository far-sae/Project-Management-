# Supabase Configuration (Required)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Optional: Google Web client id (same one Supabase's Google provider uses).
# When set, Google sign-in returns to this site so Google shows "TaskCalendar".
# Also add https://<your-domain>/auth/google to the client's Authorized redirect URIs.
VITE_GOOGLE_CLIENT_ID=

# Task lock PIN: optional server RPC (migration 021). Leave unset or omit — the app uses a
# client-side PIN check and will not call PostgREST. After you apply
# supabase/migrations/021_verify_task_lock_pin.sql and NOTIFY pgrst, 'reload schema'; set:
# VITE_VERIFY_TASK_LOCK_PIN_RPC=true

# App Owner User IDs (comma-separated user IDs that have full access)
# Get from: https://app.supabase.com/project/_/settings/api
VITE_APP_OWNER_USER_IDS=

# Email (invitations + notifications) is sent by the `send-email` Supabase Edge
# Function through Resend. Set these as Supabase Edge Function secrets, not here:
#   RESEND_API_KEY=re_...                       (resend.com → API Keys)
#   RESEND_FROM="TaskCalendar <noreply@taskcalendar.co.uk>"   (verified domain)

# Calls — LiveKit (SFU) is now used for all 1:1 and project-wide group calls.
# The LiveKit Cloud free tier (10k participant-minutes/month) covers small teams.
#
# 1) Sign up at https://cloud.livekit.io and create a project.
# 2) From the project Settings → Keys panel, grab the API key, API secret, and
#    the wss:// URL (looks like wss://yourname.livekit.cloud).
# 3) Add the API key/secret as Edge Function secrets in Supabase
#    (Project Settings → Edge Functions → Secrets):
#      LIVEKIT_API_KEY
#      LIVEKIT_API_SECRET
#      LIVEKIT_URL
# 4) Set the wss:// URL here so the client knows where to connect:
# VITE_LIVEKIT_URL=
# 5) Deploy the token edge function:
#      supabase functions deploy livekit-token
#
# That's it — calls automatically route through LiveKit. NAT traversal, TURN
# relays, simulcast and reconnection are all handled by the LiveKit server,
# so the previous self-hosted TURN settings are no longer needed.

